# Copy this file to .env and fill in the values
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/tester
JWT_SECRET=change-me-to-a-long-random-string
# Where the client is hosted (CORS). Several allowed, comma separated, no trailing slash, e.g.
# CLIENT_URL=https://myname.github.io,http://localhost:5173
CLIENT_URL=http://localhost:5173

# true  = allow testing APIs on localhost / private network (handy during development)
# false = block them (ALWAYS use false on a public server, see README "Security")
ALLOW_PRIVATE_URLS=false

# Comma-separated emails that become admins (approve viewers and choose which projects they can read)
ADMIN_EMAIL=

# Only needed if your network refuses mongodb+srv:// lookups
DNS_SERVERS=
